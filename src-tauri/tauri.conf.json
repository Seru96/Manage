{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IMPLANTA Manage",
  "mainBinaryName": "IMPLANTA Manage",
  "version": "0.2.0",
  "identifier": "com.implanta.manage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IMPLANTA Manage",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["manage"],
        "name": "Proyecto IMPLANTA Manage",
        "description": "Proyecto IMPLANTA Manage",
        "role": "Editor",
        "mimeType": "application/vnd.implanta.manage"
      }
    ],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Spanish"], "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
